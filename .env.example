# Copy to .env and fill in. Compose reads .env from this directory.
# `docker compose config` will tell you if something required is missing.
#
# NOTE: docker compose interpolates `$` inside values. A `$` in a secret is
# silently mangled — generate secrets with the commands below, which produce
# hex, or escape a literal `$` as `$$`.

# --- required -------------------------------------------------------------

# Inference, straight to OpenRouter from the cockpit process. The researcher
# makes a lot of calls: one real stage-1 run was 1.7M tokens.
OPENROUTER_API_KEY=

# Signs the session cookie. Changing it logs you out.
#   openssl rand -hex 32
MRA_JWT_SECRET=

# SearXNG's own session/cookie secret. Not shared with anything else — just
# needs to be present and non-empty.
#   openssl rand -hex 32
SEARXNG_SECRET=

# Firecrawl, for fetching page content — search finds a URL, this reads it.
# SearXNG (above) is search-only and cannot do this part. Cloud API, free
# tier: https://www.firecrawl.dev/app/api-keys
#
# Self-hosting Firecrawl instead is real but not small — their own stack is
# 5+ containers (an API, a headless-browser service, Redis, RabbitMQ or
# FoundationDB, Postgres) built from source, not pulled as images. A project
# of its own; ask if you want it later.
FIRECRAWL_API_KEY=

# --- local development -----------------------------------------------------

# http://localhost cannot set a Secure cookie — a browser silently drops it,
# so login appears to succeed and then immediately logs you back out. Flip
# this to true (docker-compose.yaml's own default) the day this sits behind
# real TLS.
MRA_COOKIE_SECURE=false

# --- optional ---------------------------------------------------------------

# Login. Leave EMPTY for local development and authentication is disabled —
# which is why docker-compose.yaml binds the cockpit to 127.0.0.1 only. Set
# it before this ever reaches a shared network:
#   docker compose run --rm --entrypoint sh mra -c "npm run hashpw"
MRA_APP_USER=ash
MRA_APP_PASSWORD_HASH=

# Model for research runs.
#
# There is no gateway in front of inference any more, so there is no "gateway
# default" to fall back on — this is always a concrete OpenRouter model id,
# and docker-compose.yaml supplies the one below when this is empty.
#
# The default is chosen for context and price rather than raw capability: a
# stage-1 run is dozens of turns over long fetched pages, so the 1M-token
# window matters more than the reasoning ceiling, and the run above cost about
# $0.03 of input at these rates. Any OpenRouter model id works; one with a
# small context window will fail partway through a long run.
MRA_MODEL=deepseek/deepseek-v4-flash-0731
